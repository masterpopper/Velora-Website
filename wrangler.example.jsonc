{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // TEMPLATE ONLY. Copy to wrangler.jsonc and replace the D1 ID before an authorized deployment.
  // Do not point this template at the production velora-website Worker during preparation.
  "name": "velora-purchases-test",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory":"./dist","binding":"ASSETS","run_worker_first":["/api/*"]},
  "d1_databases": [{"binding":"DB","database_name":"valora-purchases-test","database_id":"REPLACE_WITH_ACTUAL_D1_DATABASE_UUID"}],
  "vars": {
    "SITE_ORIGIN":"https://REPLACE_WITH_CONFIRMED_BACKEND_ORIGIN",
    "PAYMENTS_MODE":"test",
    "PURCHASES_ENABLED":"false",
    "LIVE_PAYMENTS_APPROVED":"false"
  }
}
